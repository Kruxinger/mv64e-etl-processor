# LMU-specific additions on top of env-sample.env.
#
# Copy both env-sample.env AND this file to a real ".env" (or merge into one),
# fill in the blanks, and NEVER commit the filled-in version - only *.env is
# gitignored already (see .gitignore), env-sample*.env files stay tracked as
# documentation/templates.

# --- Pseudonymization: two-step gPAS (Arbeitsnummer -> Vorgangsnummer) ---
# Selects the LMU pseudonymization flow instead of upstream's single-domain GPAS/BUILDIN
DNPM_PSEUDONYMIZE_GENERATOR=GPAS_KEYCLOAK
APP_PSEUDONYMIZE_GPAS_SOAP_ENDPOINT=
APP_PSEUDONYMIZE_GPAS_KEYCLOAK_TOKENURI=
APP_PSEUDONYMIZE_GPAS_KEYCLOAK_CLIENTID=
APP_PSEUDONYMIZE_GPAS_KEYCLOAK_CLIENTSECRET=
# only override if your gPAS instance uses different domain names than these defaults:
#APP_PSEUDONYMIZE_GPAS_KEYCLOAK_ARBEITSNUMMERDOMAIN=arbeitsnummer
#APP_PSEUDONYMIZE_GPAS_KEYCLOAK_VORGANGSNUMMERDOMAIN=vorgangsnummer
#APP_PSEUDONYMIZE_GPAS_KEYCLOAK_ARBEITSNUMMERPREFIX=00

# --- Consent: Broad Consent via DIZ (Keycloak-secured gICS-shaped FHIR search) ---
# MVConsent itself comes embedded in the incoming Mtb file from Onkostar/the export
# plugin, not from here - this only covers the Broad Consent lookup against DIZ.
APP_CONSENT_SERVICE=diz_keycloak
APP_CONSENT_DIZ_URI=
APP_CONSENT_DIZ_KEYCLOAKTOKENURI=
APP_CONSENT_DIZ_KEYCLOAKCLIENTID=
APP_CONSENT_DIZ_KEYCLOAKCLIENTSECRET=
# only override if these MII Broad Consent defaults don't match your DIZ/gICS instance:
#APP_CONSENT_DIZ_PERSONIDENTIFIERSYSTEM=https://ths-greifswald.de/fhir/gics/identifiers/Patienten-ID
#APP_CONSENT_DIZ_BROADCONSENTDOMAINNAME=MII

# --- TLS trust for the three LMU-internal hosts (Keycloak/gPAS/DIZ) ---
# Do NOT put certs here. Drop the *.pem files documented in bindings/README.md into
# bindings/ca-certificates/ (already gitignored per-file) and build the image locally
# with BP_EMBED_CERTS=true - see bindings/README.md for the full procedure. This
# covers ALL outbound HTTPS clients (gPAS SOAP, DIZ/gICS REST, Keycloak token calls,
# DNPM:DIP REST) uniformly, since it's baked into the JVM's default truststore at
# image build time - no code/env changes needed here for that part.
